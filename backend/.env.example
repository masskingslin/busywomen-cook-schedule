# Copy this file to backend/.env and fill it in:   cp .env.example .env
# backend/.env holds your secrets. It is never served to visitors, and
# .gitignore keeps it out of GitHub. Lines starting with # are comments.

# ---- owner dashboard -----------------------------------------------------
# Needed for the /admin page. At least 16 characters. Make one with:
#   python3 -c "import secrets;print(secrets.token_hex(24))"
# ADMIN_TOKEN=

# ---- e-mail alerts for feedback (optional but recommended) --------------
# Where feedback is delivered. This address lives ONLY here, on your server;
# the website never contains it and visitors never see it.
# NOTIFY_TO=you@yahoo.com
# Sending goes through your own mailbox. For Yahoo, create an "app password"
# (Yahoo Account Security -> Generate app password) - do NOT use your normal
# password.
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl          # ssl (port 465) | starttls (port 587) | none
# SMTP_USER=you@yahoo.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@yahoo.com    # optional, defaults to SMTP_USER

# ---- network -------------------------------------------------------------
# HOST=127.0.0.1             # keep this when you put Cloudflare Tunnel in front
# PORT=8090
# Websites allowed to call the API from a browser (comma separated). Only
# needed when the site is hosted somewhere else, e.g. GitHub Pages.
# ALLOWED_ORIGINS=https://masskingslin.github.io

# ---- optional ------------------------------------------------------------
# SERVE_STATIC=1             # 1 = this process also serves the website itself
# DB_PATH=/path/to/app.db    # default: backend/data/app.db
# DISABLE_CSP=0              # set 1 only if a security header blocks something
